# Render server-side configuration. Never copy any of these into frontend/.env.
PORT=8787
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
E2B_API_KEY=e2b_your_secret
ABLY_API_KEY=your_ably_key_name:your_ably_secret
CORS_ORIGIN=https://your-project.vercel.app
# Optional comma-separated additional approved origins for local development
# CORS_ORIGIN=http://localhost:5173,https://your-project.vercel.app
